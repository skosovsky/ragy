{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:host:retrieval-context:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uncertainty_type",
    "schema",
    "scope",
    "epoch",
    "text",
    "rank_policy",
    "references",
    "inputs",
    "snippets",
    "coverage",
    "progress",
    "partial",
    "omissions",
    "truncated",
    "precision",
    "resource",
    "diagnostics",
    "boundary",
    "projection_count",
    "rendered_snippet_count",
    "digest"
  ],
  "properties": {
    "uncertainty_type": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "host.retrieval-context/1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "namespace",
        "subject"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string"
    },
    "rank_policy": {
      "const": "host.rank-ordinal/canonical-id-1"
    },
    "references": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "record_id",
          "revision"
        ],
        "properties": {
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tenant",
              "namespace",
              "subject"
            ],
            "properties": {
              "tenant": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      }
    },
    "inputs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "artifact_id",
          "score",
          "score_state",
          "score_semantics",
          "score_history",
          "rank",
          "uncertainty",
          "sources",
          "extractor",
          "losses",
          "uncertainties"
        ],
        "properties": {
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "record_id",
              "revision"
            ],
            "properties": {
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tenant",
                  "namespace",
                  "subject"
                ],
                "properties": {
                  "tenant": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            }
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "score_state": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "score_semantics": {
            "type": "string"
          },
          "score_history": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "DocumentID",
                "Value",
                "State",
                "Semantics"
              ],
              "properties": {
                "DocumentID": {
                  "type": "string"
                },
                "Value": {
                  "type": "number"
                },
                "State": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "Semantics": {
                  "type": "string"
                }
              }
            }
          },
          "rank": {
            "type": "integer",
            "minimum": 0
          },
          "uncertainty": {},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "extractor": {
            "type": "string",
            "minLength": 1
          },
          "losses": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "uncertainties": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "snippets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "content",
          "span",
          "mapping",
          "supports",
          "contributors",
          "full_document",
          "delivery_uncertain",
          "provenance",
          "score",
          "score_state",
          "score_semantics",
          "score_history",
          "rank"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "span": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          },
          "mapping": {
            "type": "object"
          },
          "supports": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object"
            }
          },
          "contributors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "InputIndex",
                "FullDocument",
                "DeliveryUncertain"
              ],
              "properties": {
                "InputIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "FullDocument": {
                  "type": "boolean"
                },
                "DeliveryUncertain": {
                  "type": "boolean"
                }
              }
            }
          },
          "full_document": {
            "type": "boolean"
          },
          "delivery_uncertain": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "SourceID",
              "URI",
              "Label"
            ],
            "properties": {
              "SourceID": {
                "type": "string"
              },
              "URI": {
                "type": "string"
              },
              "Label": {
                "type": "string"
              }
            }
          },
          "score": {
            "type": "number"
          },
          "score_state": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "score_semantics": {
            "type": "string"
          },
          "score_history": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "DocumentID",
                "Value",
                "State",
                "Semantics"
              ],
              "properties": {
                "DocumentID": {
                  "type": "string"
                },
                "Value": {
                  "type": "number"
                },
                "State": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "Semantics": {
                  "type": "string"
                }
              }
            }
          },
          "rank": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "coverage": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend",
          "status",
          "minimum_satisfied"
        ],
        "properties": {
          "backend": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "degraded",
              "pending",
              "unavailable",
              "eventual"
            ]
          },
          "minimum_satisfied": {
            "type": "boolean"
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "returned_candidates",
        "canonical_checked",
        "canonical_filtered",
        "ranking_omitted",
        "candidates_truncated"
      ],
      "properties": {
        "returned_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_checked": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_filtered": {
          "type": "integer",
          "minimum": 0
        },
        "ranking_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_truncated": {
          "type": "boolean"
        }
      }
    },
    "partial": {
      "type": "boolean"
    },
    "omissions": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "precision": {
      "enum": [
        "preserved",
        "unavailable"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Limit",
        "Used",
        "Measurements",
        "MaxCandidates",
        "MaxMeasurements",
        "MaxOutputBytes",
        "Unit",
        "Profile",
        "Packing"
      ],
      "properties": {
        "Limit": {
          "type": "integer",
          "minimum": 0
        },
        "Used": {
          "type": "integer",
          "minimum": 0
        },
        "Measurements": {
          "type": "integer",
          "minimum": 0
        },
        "MaxCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "MaxMeasurements": {
          "type": "integer",
          "minimum": 0
        },
        "MaxOutputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "Unit": {
          "type": "string"
        },
        "Profile": {
          "type": "string"
        },
        "Packing": {
          "enum": [
            "complete",
            "resource-limited",
            "measurement-limited"
          ]
        }
      }
    },
    "diagnostics": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "boundary": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projection_count": {
      "type": "integer",
      "minimum": 0
    },
    "rendered_snippet_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
