{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ragy.lifecycle"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "manifests": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/manifest"
      }
    },
    "publications": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/publication"
      }
    },
    "cleanups": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/cleanup_job"
      }
    },
    "inventories": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/inventory_receipt"
      }
    }
  },
  "required": [
    "schema",
    "namespace",
    "generation",
    "manifests",
    "publications",
    "cleanups",
    "inventories"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "access_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "namespace",
        "source",
        "revision",
        "transformation",
        "access_fingerprint",
        "artifact",
        "representation"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "content_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "access_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "namespace",
        "source",
        "revision",
        "content_fingerprint",
        "transformation",
        "access_fingerprint"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "supports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "reference",
        "supports"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "pending",
            "ready",
            "failed",
            "unknown"
          ]
        },
        "revision": {
          "type": "string"
        },
        "artifacts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "required": [
        "name",
        "required",
        "state",
        "revision",
        "artifacts"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "payload_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "expected_publication": {
          "type": "string"
        },
        "tombstone": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "planned",
            "staging",
            "ready",
            "published",
            "cleanup-pending",
            "complete",
            "failed",
            "canceled",
            "unknown"
          ]
        },
        "checkpoint": {
          "enum": [
            "",
            "planned",
            "staging",
            "ready",
            "published",
            "cleanup-pending",
            "complete"
          ]
        },
        "targets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "identity",
        "idempotency_key",
        "payload_fingerprint",
        "expected_publication",
        "tombstone",
        "partial",
        "state",
        "checkpoint",
        "targets",
        "published_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "planned",
                  "staging",
                  "ready",
                  "published",
                  "cleanup-pending",
                  "complete"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checkpoint": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "checkpoint": {
                "enum": [
                  "planned",
                  "staging",
                  "ready",
                  "published",
                  "cleanup-pending",
                  "complete"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tombstone": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "targets": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tombstone": {
                "const": false
              },
              "partial": {
                "const": false
              },
              "state": {
                "enum": [
                  "ready",
                  "published",
                  "cleanup-pending",
                  "complete"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "targets": {
                "items": {
                  "if": {
                    "properties": {
                      "required": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "state": {
                        "const": "ready"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "manifest"
      ]
    },
    "retired_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "pending",
            "unknown",
            "complete"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "next_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "manifest",
        "target",
        "state",
        "attempts",
        "next_at"
      ]
    },
    "cleanup_job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "overdue": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/retired_target"
          }
        }
      },
      "required": [
        "owner",
        "started_at",
        "deadline",
        "overdue",
        "complete",
        "items"
      ]
    },
    "unmanaged_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target",
        "key"
      ]
    },
    "inventory_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "delta",
            "complete"
          ]
        },
        "watermark": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "enum": [
            "partial",
            "complete"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "imported": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unmanaged": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/unmanaged_record"
          }
        },
        "missing": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/publication"
          }
        }
      },
      "required": [
        "kind",
        "watermark",
        "fingerprint",
        "coverage",
        "targets",
        "imported",
        "unmanaged",
        "missing"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "const": "complete"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delta"
              }
            }
          },
          "then": {
            "properties": {
              "missing": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
